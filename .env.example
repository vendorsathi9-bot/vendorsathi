# VendorSaathi environment overrides (example).
#
# The Go backend reads environment variables directly; it does not load this
# file automatically. Copy the values you need into your shell, systemd unit,
# Docker Compose environment, or deployment platform.
#
# Never commit a real secret. This file intentionally contains no credentials.

# --- Required backend settings ---
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5433/vendorsaathi?sslmode=disable
JWT_SIGNING_KEY=change-me-to-a-random-string-of-at-least-32-characters

# Apply pending SQL migrations automatically when the API starts.
# Migrations are versioned, non-destructive and serialized with an advisory lock.
MIGRATION_PATH=file://migrations
MIGRATION_AUTO_APPLY=true

# --- Map / tiles ---
# MapLibre style URL used by the Android app and admin dashboard.
# Default: OpenFreeMap (free, keyless, commercial app usage allowed).
# Do not use the public OSM tile servers (tile.openstreetmap.org) for an app.
MAP_PROVIDER=openfreemap
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_ATTRIBUTION=© OpenFreeMap © OpenMapTiles © OpenStreetMap contributors

# Optional: only if you use the legacy raster /mobility/tiles proxy.
# Example XYZ template: https://your-raster-provider.example/{z}/{x}/{y}.png
MAP_TILE_URL=
MAP_UPSTREAM_TILE_URL=
# If your optional raster provider needs a key, set it here (server-side only)
# and include {key} in the URL template above.
MAP_API_KEY=
MAP_USER_AGENT=VendorSaathi/1.0 (+https://vendorsaathi.in; contact: admin@vendorsaathi.in)

# --- Routing / geocoding (unchanged) ---
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org

# --- First administrator bootstrap (cmd/create-admin only) ---
# Never commit real values. The CLI refuses documented demo passwords.
# ADMIN_PHONE=+919876543210
# ADMIN_PASSWORD=
# ADMIN_EMAIL=
# ADMIN_UPDATE_PASSWORD=false
