# VendorSaathi landing website — environment variables
#
# Copy this file to `.env` (or configure the same variables in Vercel).
# Only variables prefixed with VITE_ are exposed to the browser.
# Never put private API keys or secrets in this file.

# Public Android APK download URL. Set this to the real GitHub Release asset
# URL once the APK has been uploaded, for example:
#   https://github.com/vendorsathi9-bot/vendorsathi/releases/download/<RELEASE_TAG>/<APK_ASSET_NAME>
# Leave empty until that asset exists: the Download section keeps the
# "Download for Android" button visible but disabled instead of inventing a link.
VITE_ANDROID_APK_URL=

# Backwards-compatible alias for the same download URL. VITE_ANDROID_APK_URL
# takes precedence when both are set.
VITE_APP_DOWNLOAD_URL=

# Public Android release metadata verified from the generated APK. Update these
# after each production build (versionName from pubspec.yaml, APK file size).
VITE_APP_VERSION=1.0.0
VITE_APK_SIZE=85.9 MB

# Public URL of the VendorSaathi admin dashboard. Defaults to the deployed
# Vercel dashboard when empty.
VITE_ADMIN_DASHBOARD_URL=https://vendorsathi-o9w010418-vendor8.vercel.app

# Optional public contact address (e.g. hello@your-domain.com).
# When empty, the site shows that contact details will be published soon.
VITE_CONTACT_EMAIL=

# Optional canonical site origin used for absolute Open Graph URLs,
# e.g. https://vendorsaathi.com. Works with or without a trailing slash.
VITE_SITE_URL=
