# VendorSaathi landing website — environment variables
#
# Copy this file to `.env` (or configure the same variables in Vercel).
# Only variables prefixed with VITE_ are exposed to the browser.
# Never put private API keys or secrets in this file.

# Public Android app download URL. When empty, the Download section shows a
# "coming soon" state instead of inventing a link.
VITE_APP_DOWNLOAD_URL=

# Public URL of the VendorSaathi admin dashboard. When empty, the admin section
# and footer show no dashboard link.
VITE_ADMIN_DASHBOARD_URL=

# Optional public contact address (e.g. hello@your-domain.com).
# When empty, the site shows that contact details will be published soon.
VITE_CONTACT_EMAIL=

# Optional canonical site origin used for absolute Open Graph URLs,
# e.g. https://vendorsaathi.com. Works with or without a trailing slash.
VITE_SITE_URL=
