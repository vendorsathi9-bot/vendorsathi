APP_ENV: development
HTTP_ADDR: ":8080"
DATABASE_URL: "postgres://postgres:postgres@localhost:5432/vendorsaathi?sslmode=disable"
LOG_LEVEL: "debug"
REQUEST_TIMEOUT: "30s"
MIGRATION:
  PATH: "file://migrations"

JWT:
  SIGNING_KEY: "your-super-secret-signing-key-change-in-production-min-32-chars"
  ISSUER: "vendorsaathi"
  AUDIENCE: "vendorsaathi-api"
  ACCESS_TOKEN_TTL: "15m"
  REFRESH_TOKEN_TTL: "720h"

PASSWORD_HASH:
  ALGORITHM: "argon2id"
  MEMORY: 65536
  ITERATIONS: 3
  PARALLELISM: 4
  SALT_LENGTH: 16
  KEY_LENGTH: 32

CORS_ORIGINS:
  - "http://localhost:3000"
  - "http://localhost:5173"
  - "http://localhost:8080"

FCM:
  CREDENTIALS_PATH: ""
  PROJECT_ID: ""

MAP:
  PROVIDER: "maplibre"
  TILE_URL: "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
  ROUTING_PROVIDER: "osrm"
  OSRM_BASE_URL: "https://router.project-osrm.org"
  GEOCODING_PROVIDER: "nominatim"
  GEOCODING_BASE_URL: "https://nominatim.openstreetmap.org"

WEATHER:
  API_KEY: ""

STORAGE:
  ENDPOINT: "localhost:9000"
  BUCKET: "vendorsaathi"
  ACCESS_KEY_ID: "minioadmin"
  SECRET_ACCESS_KEY: "minioadmin"
  REGION: "us-east-1"
  USE_SSL: false

PAYMENT:
  RAZORPAY_KEY_ID: ""
  RAZORPAY_KEY_SECRET: ""
